[Unit]
Description=Minha Frota API WSGI
After=network.target

[Service]
Type=simple
User=minhafrota
Group=minhafrota
WorkingDirectory=/opt/minhafrota
Environment=MINHA_FROTA_DATA_DIR=/var/lib/minhafrota
Environment=MINHA_FROTA_SEED_DEMO=1
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=minhafrota
StateDirectoryMode=0750
ExecStartPre=/opt/minhafrota/.venv/bin/python app.py --init-db
ExecStart=/opt/minhafrota/.venv/bin/gunicorn --bind 127.0.0.1:3001 --workers 1 --threads 2 --timeout 30 --error-logfile - app:application
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/minhafrota
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
